# Copy to .env.local and fill in. Also add these to your host's environment
# variables (e.g. Vercel → Project → Settings → Environment Variables).
# Never commit real keys.

# ---- Booking (Cal.com) -------------------------------------------------
# Your event's path on Cal.com — the part after cal.com/.
# Example: NEXT_PUBLIC_CAL_LINK=manoj-rawat/15min
# Until set, "Book a call" shows a setup notice instead of the scheduler.
# NEXT_PUBLIC_ values are built into the page: rebuild after changing them.
NEXT_PUBLIC_CAL_LINK=
# Only for Cal.com EU accounts:
# NEXT_PUBLIC_CAL_ORIGIN=https://app.cal.eu

# ---- Contact form delivery (Resend) ------------------------------------
# Without all three, /api/contact answers 503 and the form shows its error
# state ("Something went wrong…") — nothing pretends to be sent.
RESEND_API_KEY=
# Inbox that receives messages:
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "Portfolio <hello@yourdomain.com>".
# For a first test, "Portfolio <onboarding@resend.dev>" works but only
# delivers to the email address of your Resend account.
CONTACT_FROM_EMAIL=
